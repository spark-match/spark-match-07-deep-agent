# =============================================================================
# Spark Match Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Environment ---
# Options: local | agentcore
SPARK_ENVIRONMENT=local

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
SPARK_LOG_LEVEL=INFO

# --- Model Configuration ---
# Provider: bedrock | openai | anthropic | ollama
SPARK_MODEL_PROVIDER=bedrock
# Model ID — must stay within the Bedrock IAM allowlist (only these two
# inference profiles are permitted; anything else is AccessDeniedException).
SPARK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Cheaper/faster model for low-stakes routing decisions (Sprint 8 router).
SPARK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS Region for Bedrock
SPARK_AWS_REGION=us-east-1
# Max output tokens per model call (model + fast_model). POC v2 lesson 9
# (Sprint 8, task 8.6): caps generation length to reduce latency.
SPARK_MAX_TOKENS=2048

# --- AWS Credentials ---
# If using Bedrock, ensure AWS credentials are configured via:
# - AWS CLI (aws configure)
# - Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# - IAM Role (if running on AWS infrastructure)

# --- API Server ---
SPARK_API_HOST=0.0.0.0
SPARK_API_PORT=8000
# Comma-separated list of allowed origins (Angular dev server)
SPARK_CORS_ORIGINS=["http://localhost:4200"]

# --- Agent limits ---
# Max LLM turns per session (LangGraph MessagesState length cap)
SPARK_MAX_TURNS=50
# Max web_search tool calls per session (prevents Tavily quota burn)
# Set to 0 to disable the cap
SPARK_MAX_WEB_SEARCHES_PER_SESSION=6

# --- Observability (optional) ---
# SPARK_LANGSMITH_API_KEY=your-langsmith-api-key
# SPARK_LANGSMITH_PROJECT=spark-match-agent
# SPARK_LANGSMITH_TRACING=true

# --- Web Search ---
# Tavily (primary): Get free API key at https://tavily.com (1,000 searches/month free)
# SPARK_TAVILY_API_KEY=tvly-your-api-key-here
# DuckDuckGo (fallback): No API key needed, works automatically

# --- Persistence (Sprint 6) ---
# memory | sqlite | postgres. memory/sqlite work fully offline (no AWS
# account needed). postgres is not implemented yet (task 6.A.3 of the
# roadmap — requires Secrets Manager DSN resolution).
SPARK_PERSISTENCE_BACKEND=sqlite
# Only used when SPARK_PERSISTENCE_BACKEND=sqlite
SPARK_SQLITE_PATH=.spark-match/checkpoints.sqlite

# --- Auth (Sprint 7) ---
# Local/dev override for the JWT signing secret used by
# spark-match-03-backend. Set this to run and test auth fully offline (hard
# rule #7) — no AWS SSM/Secrets Manager needed. Leave unset in
# agentcore/production to resolve it from SPARK_JWT_SECRET_SSM_PARAM instead.
# SPARK_JWT_SECRET=your-local-dev-shared-secret
SPARK_JWT_SECRET_SSM_PARAM=/spark-match/secret/jwt-arn
SPARK_JWT_SECRET_CACHE_SECONDS=300

# --- API hardening (Sprint 7, task 7.E) ---
# Requests per user per minute allowed on POST /ag-ui.
SPARK_RATE_LIMIT_PER_MINUTE=5
# Daily invocation cap per authenticated user_id, enforced against the
# persistence store. Set to 0 to disable.
SPARK_BUDGET_MAX_REQUESTS_PER_USER_PER_DAY=200


